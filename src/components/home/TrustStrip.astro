---
import Container from "../common/Container.astro";
---

<section class="trust-strip" aria-labelledby="trust-strip-title">
  <Container>
    <h2 id="trust-strip-title" class="sr-only">Hizmet yaklaşımımız</h2>

    <ul class="trust-strip__list">
      <li class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 5.5h14v10H9l-4 3v-13Z" />
            <path d="M9 9h6M9 12h4" />
          </svg>
        </span>
        <h3>Hızlı İletişim</h3>
      </li>

      <li class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="4" y="4" width="6" height="6" rx="1" />
            <rect x="14" y="4" width="6" height="6" rx="1" />
            <rect x="4" y="14" width="6" height="6" rx="1" />
            <rect x="14" y="14" width="6" height="6" rx="1" />
          </svg>
        </span>
        <h3>Geniş Hizmet Yelpazesi</h3>
      </li>

      <li class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m12 3 1.3 4.2L17.5 8.5l-4.2 1.3L12 14l-1.3-4.2-4.2-1.3 4.2-1.3L12 3Z" />
            <path d="m18.5 14 .7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3Z" />
          </svg>
        </span>
        <h3>Temiz İşçilik</h3>
      </li>

      <li class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3.5 19 6v5.5c0 4.2-2.7 7.4-7 9-4.3-1.6-7-4.8-7-9V6l7-2.5Z" />
            <path d="m8.5 12 2.2 2.2 4.8-4.8" />
          </svg>
        </span>
        <h3>Güvenilir Çözüm</h3>
      </li>
    </ul>
  </Container>
</section>

<style>
  .trust-strip {
    border-top: 3px solid var(--brand-gold);
    border-bottom: 1px solid var(--border);
    background: var(--bg-warm);
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }

  .trust-strip__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-strip__item {
    display: flex;
    min-height: 5.25rem;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--white);
    padding: 1rem 1.1rem;
    box-shadow: 0 0.35rem 1.25rem rgb(11 29 58 / 4%);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      translate 160ms ease;
  }

  .trust-strip__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    place-items: center;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--brand-gold) 18%, var(--white));
    color: var(--brand-navy);
  }

  .trust-strip__icon svg {
    width: 1.55rem;
    height: 1.55rem;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust-strip__item h3 {
    margin: 0;
    color: var(--brand-navy);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .trust-strip__item:hover {
      border-color: color-mix(in srgb, var(--brand-gold) 70%, var(--border));
      box-shadow: var(--shadow-soft);
      translate: 0 -2px;
    }
  }

  @media (min-width: 40rem) {
    .trust-strip__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .trust-strip__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .trust-strip__item {
      min-height: 6.25rem;
      padding-inline: clamp(0.85rem, 1.4vw, 1.2rem);
    }
  }
</style>

