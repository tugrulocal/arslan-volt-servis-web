---
import Button from "../common/Button.astro";
import Container from "../common/Container.astro";
import ReviewCard from "./ReviewCard.astro";
import { getPublicReviews } from "../../lib/reviews/public";

const { reviews, unavailable } = await getPublicReviews({
  verifiedOnly: true,
  limit: 3,
});
const carouselGroups = reviews.length > 1 ? Array.from({ length: 5 }) : [0];
---

<section class="home-reviews" aria-labelledby="home-reviews-title">
  <Container>
    <div class="home-reviews__header">
      <div>
        <p class="home-reviews__eyebrow">Müşteri yorumları</p>
        <h2 id="home-reviews-title">Hizmeti alanların deneyimi</h2>
      </div>
    </div>

    {
      reviews.length > 0 ? (
        <div class="home-reviews__carousel" data-home-reviews-carousel>
          <div class="home-reviews__viewport" data-carousel-viewport tabindex="0" aria-label="Son müşteri yorumları">
            <ul class="home-reviews__list" data-carousel-track data-loop={reviews.length > 1 ? "true" : "false"}>
              {carouselGroups.map((_, groupIndex) => (
                <li class="home-reviews__group" aria-hidden={groupIndex > 0 ? "true" : undefined}>
                  <ul>
                    {reviews.map((review) => (
                      <li><ReviewCard review={review} /></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <div class="home-reviews__empty">
          <p>
            {unavailable
              ? "Yorum sistemi şu an yapılandırma bekliyor; site içeriği ve iletişim kanalları çalışmaya devam ediyor."
              : "Henüz yayınlanmış doğrulanmış yorum yok. İlk gerçek yorumlar eklendiğinde burada görünecek."}
          </p>
        </div>
      )
    }

    <div class="home-reviews__actions">
      <Button href="/yorumlar" variant="secondary">Tüm Yorumları Gör</Button>
      <Button href="/yorumlar#yorum-yap" variant="outline">Yorum Yap</Button>
    </div>
  </Container>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-home-reviews-carousel]");
  const viewport = carousel?.querySelector<HTMLElement>("[data-carousel-viewport]");
  const track = carousel?.querySelector<HTMLElement>("[data-carousel-track]");

  if (carousel && viewport && track) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const groups = Array.from(track.children).filter((child) =>
      child.classList.contains("home-reviews__group"),
    ) as HTMLElement[];
    const middleGroupIndex = Math.max(1, Math.floor(groups.length / 2));
    const canLoop = track.dataset.loop === "true" && groups.length >= 5 && !prefersReducedMotion;
    let groupWidth = 0;
    let isPaused = false;
    let interactionTimer: number | undefined;
    let frameId: number | undefined;
    let lastFrameTime = 0;

    const measure = () => {
      const firstGroup = groups[0];
      const secondGroup = groups[1];
      groupWidth = firstGroup && secondGroup
        ? secondGroup.offsetLeft - firstGroup.offsetLeft
        : firstGroup?.scrollWidth || 0;

      if (canLoop && groupWidth > 0) {
        viewport.scrollLeft = groupWidth * middleGroupIndex;
      }
    };

    const normalizeScrollPosition = () => {
      if (!canLoop || groupWidth <= 0) return;

      if (viewport.scrollLeft < groupWidth) {
        viewport.scrollLeft += groupWidth;
      } else if (viewport.scrollLeft >= groupWidth * (groups.length - 2)) {
        viewport.scrollLeft -= groupWidth;
      }
    };

    const pauseTemporarily = () => {
      isPaused = true;
      if (interactionTimer) window.clearTimeout(interactionTimer);
      interactionTimer = window.setTimeout(() => {
        isPaused = carousel.matches(":hover") || carousel.matches(":focus-within");
      }, 1400);
    };

    const animate = (time: number) => {
      const elapsed = lastFrameTime ? time - lastFrameTime : 16;
      lastFrameTime = time;

      if (!isPaused && canLoop && groupWidth > 0) {
        viewport.scrollLeft += (elapsed / 1000) * 18;
        normalizeScrollPosition();
      }

      frameId = window.requestAnimationFrame(animate);
    };

    carousel.addEventListener("mouseenter", () => {
      isPaused = true;
    });
    carousel.addEventListener("mouseleave", () => {
      isPaused = carousel.matches(":focus-within");
    });
    viewport.addEventListener("focusin", () => {
      isPaused = true;
    });
    viewport.addEventListener("focusout", () => {
      isPaused = carousel.matches(":hover");
    });
    viewport.addEventListener("scroll", normalizeScrollPosition, { passive: true });

    ["pointerdown", "wheel", "touchstart", "keydown"].forEach((eventName) => {
      viewport.addEventListener(eventName, pauseTemporarily, { passive: true });
    });
    ["pointerup", "pointercancel", "touchend"].forEach((eventName) => {
      viewport.addEventListener(eventName, pauseTemporarily, { passive: true });
    });

    window.requestAnimationFrame(measure);
    window.setTimeout(measure, 350);
    window.addEventListener("resize", measure);
    frameId = window.requestAnimationFrame(animate);

    const cleanup = () => {
      if (frameId) window.cancelAnimationFrame(frameId);
      if (interactionTimer) window.clearTimeout(interactionTimer);
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
    window.addEventListener("pagehide", cleanup, { once: true });
  }
</script>

<style>
  .home-reviews {
    border-top: 1px solid var(--border);
    background:
      linear-gradient(180deg, rgb(247 247 242 / 94%), rgb(255 255 255 / 92%)),
      var(--bg-warm);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .home-reviews__header {
    display: grid;
    gap: 1.5rem;
  }

  .home-reviews__eyebrow {
    margin: 0 0 0.55rem;
    color: var(--brand-gold);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-reviews h2 {
    max-width: 44rem;
    margin: 0;
    color: var(--brand-navy);
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .home-reviews__carousel {
    margin: clamp(2rem, 5vw, 3.25rem) 0 0;
  }

  .home-reviews__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    margin-block: -1rem;
    padding-block: 1rem;
    scrollbar-width: thin;
    scrollbar-color: rgb(11 29 58 / 26%) transparent;
  }

  .home-reviews__viewport:focus-visible {
    outline: 3px solid rgb(212 175 55 / 62%);
    outline-offset: 0.35rem;
  }

  .home-reviews__list,
  .home-reviews__group ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-reviews__list {
    width: max-content;
    gap: 0;
  }

  .home-reviews__group ul {
    padding-right: 1rem;
  }

  .home-reviews__group {
    flex: 0 0 auto;
  }

  .home-reviews__group ul {
    flex: 0 0 auto;
  }

  .home-reviews__group > ul > li {
    flex: 0 0 min(76vw, 18.5rem);
  }

  :global(.home-reviews .review-card) {
    gap: 0.8rem;
    padding: 1rem;
  }

  :global(.home-reviews .review-card__topline) {
    gap: 0.55rem;
  }

  :global(.home-reviews .review-card__badge) {
    min-height: 1.75rem;
    padding-inline: 0.6rem;
    font-size: 0.72rem;
  }

  :global(.home-reviews .review-card blockquote) {
    font-size: 0.98rem;
    line-height: 1.55;
  }

  :global(.home-reviews .review-card blockquote p) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  :global(.home-reviews .review-card footer) {
    font-size: 0.84rem;
  }

  .home-reviews__empty {
    margin-top: 2rem;
    border: 1px dashed rgb(11 29 58 / 24%);
    border-radius: 0.5rem;
    padding: 1.25rem;
    color: var(--slate);
    font-weight: 700;
  }

  .home-reviews__empty p {
    margin: 0;
  }

  .home-reviews__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .home-reviews__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .home-reviews__group > ul > li {
      flex-basis: calc((min(100vw - 2rem, 76rem) - 2rem) / 3);
    }

    :global(.home-reviews .review-card) {
      gap: 1.1rem;
      padding: clamp(1.1rem, 2.4vw, 1.45rem);
    }

    :global(.home-reviews .review-card blockquote) {
      font-size: clamp(1rem, 0.96rem + 0.18vw, 1.08rem);
      line-height: 1.65;
    }

    :global(.home-reviews .review-card blockquote p) {
      display: block;
      overflow: visible;
      -webkit-line-clamp: unset;
    }

    :global(.home-reviews .review-card footer) {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-reviews__viewport {
      scroll-behavior: auto;
    }

  }
</style>
