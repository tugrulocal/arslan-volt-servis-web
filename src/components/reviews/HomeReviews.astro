---
import Button from "../common/Button.astro";
import Container from "../common/Container.astro";
import ReviewCard from "./ReviewCard.astro";
import { getPublicReviews } from "../../lib/reviews/public";

const { reviews, unavailable } = await getPublicReviews({
  verifiedOnly: true,
  limit: 8,
});
const carouselReviews = reviews.length > 1 ? [...reviews, ...reviews] : reviews;
---

<section class="home-reviews" aria-labelledby="home-reviews-title">
  <Container>
    <div class="home-reviews__header">
      <div>
        <p class="home-reviews__eyebrow">Müşteri yorumları</p>
        <h2 id="home-reviews-title">Hizmeti alanların deneyimi</h2>
      </div>
    </div>

    {
      reviews.length > 0 ? (
        <div class="home-reviews__carousel" data-home-reviews-carousel>
          <div
            class="home-reviews__viewport"
            tabindex="0"
            aria-label="Son müşteri yorumları"
          >
            <ul class="home-reviews__list" data-loop={reviews.length > 1 ? "true" : "false"}>
              {carouselReviews.map((review, index) => (
                <li aria-hidden={index >= reviews.length ? "true" : undefined}>
                  <ReviewCard review={review} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <div class="home-reviews__empty">
          <p>
            {unavailable
              ? "Yorum sistemi şu an yapılandırma bekliyor; site içeriği ve iletişim kanalları çalışmaya devam ediyor."
              : "Henüz yayınlanmış doğrulanmış yorum yok. İlk gerçek yorumlar eklendiğinde burada görünecek."}
          </p>
        </div>
      )
    }

    <div class="home-reviews__actions">
      <Button href="/yorumlar" variant="secondary">Tüm Yorumları Gör</Button>
      <Button href="/yorumlar#yorum-yap" variant="outline">Yorum Yap</Button>
    </div>
  </Container>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-home-reviews-carousel]");
  const viewport = carousel?.querySelector<HTMLElement>(".home-reviews__viewport");
  const track = carousel?.querySelector<HTMLElement>(".home-reviews__list");

  if (carousel && viewport && track) {
    const originalItems = Array.from(track.children).slice(0, track.children.length / 2) as HTMLElement[];

    const setMarqueeDistance = () => {
      const firstItem = originalItems[0];
      const lastItem = originalItems.at(-1);
      if (!firstItem || !lastItem) return;

      const gap = Number.parseFloat(window.getComputedStyle(track).columnGap || "0");
      const distance = lastItem.offsetLeft + lastItem.offsetWidth - firstItem.offsetLeft + gap;
      track.style.setProperty("--marquee-distance", `${Math.round(distance)}px`);
    };

    window.requestAnimationFrame(setMarqueeDistance);
    window.setTimeout(setMarqueeDistance, 350);
    window.addEventListener("resize", setMarqueeDistance);
  }
</script>

<style>
  .home-reviews {
    border-top: 1px solid var(--border);
    background:
      linear-gradient(180deg, rgb(247 247 242 / 94%), rgb(255 255 255 / 92%)),
      var(--bg-warm);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .home-reviews__header {
    display: grid;
    gap: 1.5rem;
  }

  .home-reviews__eyebrow {
    margin: 0 0 0.55rem;
    color: var(--brand-gold);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-reviews h2 {
    max-width: 44rem;
    margin: 0;
    color: var(--brand-navy);
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .home-reviews__carousel {
    margin: clamp(2rem, 5vw, 3.25rem) 0 0;
  }

  .home-reviews__viewport {
    --review-card-width: min(76vw, 18.5rem);
    --review-gap: 1rem;
    overflow-x: auto;
    overflow-y: visible;
    overscroll-behavior-x: contain;
    margin-block: -1rem;
    margin-inline: -0.75rem;
    padding: 1rem 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: rgb(11 29 58 / 26%) transparent;
  }

  .home-reviews__viewport:focus-visible {
    outline: 3px solid rgb(212 175 55 / 62%);
    outline-offset: 0.35rem;
  }

  .home-reviews__list {
    display: flex;
    width: max-content;
    gap: var(--review-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-reviews__list[data-loop="true"] {
    animation: home-reviews-marquee 36s linear infinite;
    will-change: transform;
  }

  .home-reviews__carousel:hover .home-reviews__list,
  .home-reviews__carousel:focus-within .home-reviews__list,
  .home-reviews__carousel:active .home-reviews__list {
    animation-play-state: paused;
  }

  .home-reviews__list > li {
    flex: 0 0 var(--review-card-width);
  }

  @keyframes home-reviews-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(calc(-1 * var(--marquee-distance, 0px)), 0, 0);
    }
  }

  :global(.home-reviews .review-card) {
    gap: 0.8rem;
    padding: 1rem;
  }

  :global(.home-reviews .review-card__topline) {
    gap: 0.55rem;
  }

  :global(.home-reviews .review-card__badge) {
    min-height: 1.75rem;
    padding-inline: 0.6rem;
    font-size: 0.72rem;
  }

  :global(.home-reviews .review-card blockquote) {
    font-size: 0.98rem;
    line-height: 1.55;
  }

  :global(.home-reviews .review-card blockquote p) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  :global(.home-reviews .review-card footer) {
    font-size: 0.84rem;
  }

  .home-reviews__empty {
    margin-top: 2rem;
    border: 1px dashed rgb(11 29 58 / 24%);
    border-radius: 0.5rem;
    padding: 1.25rem;
    color: var(--slate);
    font-weight: 700;
  }

  .home-reviews__empty p {
    margin: 0;
  }

  .home-reviews__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .home-reviews__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .home-reviews__viewport {
      --review-card-width: calc((min(100vw - 2rem, 76rem) - 2rem) / 3);
    }

    :global(.home-reviews .review-card) {
      gap: 1.1rem;
      padding: clamp(1.1rem, 2.4vw, 1.45rem);
    }

    :global(.home-reviews .review-card blockquote) {
      font-size: clamp(1rem, 0.96rem + 0.18vw, 1.08rem);
      line-height: 1.65;
    }

    :global(.home-reviews .review-card blockquote p) {
      display: block;
      overflow: visible;
      -webkit-line-clamp: unset;
    }

    :global(.home-reviews .review-card footer) {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-reviews__list[data-loop="true"] {
      animation: none;
    }
  }
</style>
