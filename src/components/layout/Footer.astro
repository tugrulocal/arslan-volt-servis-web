---
import { Image } from "astro:assets";
import Container from "../common/Container.astro";
import horizontalLogo from "../../assets/brand/arslanvolt_yataybuyuklogo.png";
import {
  displayBusinessValue,
  getPhoneHref,
  getWhatsAppHref,
  siteConfig,
} from "../../config/site";
import { navigationItems } from "../../data/navigation";

type ContactItem = {
  label: string;
  value: string;
  href?: string;
  external?: boolean;
};

const contactItems: ContactItem[] = [
  {
    label: "Telefon",
    value: displayBusinessValue(siteConfig.phone),
    href: getPhoneHref(),
  },
  {
    label: "WhatsApp",
    value: displayBusinessValue(siteConfig.whatsapp),
    href: getWhatsAppHref(),
    external: true,
  },
  {
    label: "Adres",
    value: displayBusinessValue(siteConfig.address),
  },
  {
    label: "Çalışma saatleri",
    value: displayBusinessValue(siteConfig.hours),
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a
          href="/"
          class="site-footer__logo-link"
          aria-label={`${siteConfig.name} ana sayfa`}
        >
          <Image
            class="site-footer__logo"
            src={horizontalLogo}
            alt=""
            width={480}
            height={240}
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>

      <nav aria-label="Alt navigasyon">
        <h2 class="site-footer__heading">Sayfalar</h2>
        <ul class="site-footer__links">
          {
            navigationItems.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))
          }
        </ul>
      </nav>

      <address class="site-footer__contact">
        <h2 class="site-footer__heading">İletişim</h2>
        <dl>
          {
            contactItems.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  {item.href ? (
                    <a
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noreferrer" : undefined}
                    >
                      {item.value}
                    </a>
                  ) : (
                    <span>{item.value}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </address>
    </div>

    <div class="site-footer__legal">
      <p>© {currentYear} {siteConfig.name}</p>
      <p>{siteConfig.slogan}</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 4px solid var(--brand-gold);
    background: var(--brand-navy);
    color: var(--white);
  }

  .site-footer__main {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .site-footer__brand {
    max-width: 25rem;
  }

  .site-footer__logo-link {
    display: inline-flex;
    max-width: 15rem;
    text-decoration: none;
  }

  .site-footer__logo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .site-footer__heading {
    margin: 0 0 1rem;
    color: var(--brand-gold-soft);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-footer__links {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__contact a {
    color: var(--white);
    text-decoration-color: rgb(226 198 106 / 65%);
    text-underline-offset: 0.25em;
  }

  .site-footer__links a:hover,
  .site-footer__contact a:hover {
    color: var(--brand-gold-soft);
  }

  .site-footer__contact {
    font-style: normal;
  }

  .site-footer__contact dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .site-footer__contact dt {
    color: #aeb9c8;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .site-footer__contact dd {
    margin: 0.2rem 0 0;
    color: var(--white);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 15%);
    padding-block: 1.25rem;
    color: #aeb9c8;
    font-size: 0.8rem;
  }

  .site-footer__legal p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: minmax(14rem, 1.4fr) minmax(10rem, 0.7fr) minmax(16rem, 1fr);
    }
  }
</style>
