---
type Props = {
  kind: "phone" | "whatsapp";
  class?: string;
};

import whatsappIconSvg from "../../assets/whatsapp logo/whatsapp-svgrepo-com.svg?raw";

const { kind, class: className } = Astro.props;

const preparedWhatsappIcon = whatsappIconSvg
  .replace(/<\?xml[^>]*>\s*/i, "")
  .replace(/<!--[\s\S]*?-->\s*/g, "")
  .replace("<svg ", `<svg class="${className ?? ""}" aria-hidden="true" `)
  .replace(/width="800px"\s*/g, "")
  .replace(/height="800px"\s*/g, "")
  .replace(/fill="#000000"/g, 'fill="currentColor"');
---

{
  kind === "phone" ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M7.48 2.75c.56 0 1.07.31 1.34.81l1.63 3.04c.31.57.21 1.27-.23 1.74l-1.28 1.38c.94 1.8 2.46 3.32 4.26 4.26l1.38-1.28c.47-.44 1.17-.53 1.74-.23l3.04 1.63c.5.27.81.78.81 1.34v2.39c0 1.25-1.02 2.27-2.27 2.27C9.95 20.1 3.5 13.65 3.5 5.7c0-1.25 1.02-2.27 2.27-2.27h1.71Z" />
    </svg>
  ) : (
    <Fragment set:html={preparedWhatsappIcon} />
  )
}
